{
  "id": "revenue",
  "version": 1,
  "title": "Выручка за период",
  "description": "Сколько начислено гостям: проживание, питание, услуги и скидки. Строки проживания считаются по дате ночи, услуги и скидки — по дате заезда брони.",
  "icon": "chart",
  "dataset": "charges",
  "params": [
    {
      "key": "period",
      "type": "dateRange",
      "label": "Период",
      "required": true,
      "default": { "preset": "currentMonth" },
      "presets": ["today", "last7", "last30", "currentMonth", "prevMonth", "currentYear", "prevYear"]
    },
    {
      "key": "groupBy",
      "type": "select",
      "label": "Группировка",
      "default": "month",
      "options": [
        { "value": "month", "label": "По месяцам" },
        { "value": "periodDate", "label": "По дням" },
        { "value": "categoryName", "label": "По категориям" },
        { "value": "building", "label": "По корпусам" },
        { "value": "floor", "label": "По этажам" },
        { "value": "roomNumber", "label": "По номерам" },
        { "value": "label", "label": "По названию строки" },
        { "value": "partnerName", "label": "По партнёрам" },
        { "value": "bookingSource", "label": "По источнику брони" },
        { "value": "guestName", "label": "По гостям" }
      ]
    },
    {
      "key": "statuses",
      "type": "multiselect",
      "label": "Статусы броней",
      "default": ["CONFIRMED", "CHECKED_IN", "CHECKED_OUT"],
      "hint": "Отменённые брони в выручку не входят — включайте их только для сверки.",
      "options": [
        { "value": "CONFIRMED", "label": "Подтверждена" },
        { "value": "CHECKED_IN", "label": "Заехал" },
        { "value": "CHECKED_OUT", "label": "Выехал" },
        { "value": "CANCELLED", "label": "Отменена" },
        { "value": "NO_SHOW", "label": "Не заехал" }
      ]
    },
    { "key": "building", "type": "select", "label": "Корпус", "optionsFrom": "buildings", "placeholder": "Все" },
    { "key": "categoryName", "type": "select", "label": "Категория", "optionsFrom": "categories", "placeholder": "Все" },
    { "key": "partnerName", "type": "select", "label": "Партнёр", "optionsFrom": "partners", "placeholder": "Любой" }
  ],
  "filters": [
    { "field": "status", "op": "in", "param": "statuses" },
    { "field": "building", "op": "eq", "param": "building" },
    { "field": "categoryName", "op": "eq", "param": "categoryName" },
    { "field": "partnerName", "op": "eq", "param": "partnerName" }
  ],
  "groupBy": { "param": "groupBy" },
  "columns": [
    { "key": "group", "field": "$group", "titleFrom": "$group", "width": 190, "total": false },
    { "key": "stay", "title": "Проживание", "metric": "stay", "width": 120 },
    { "key": "meal", "title": "Питание", "metric": "meal", "width": 110 },
    { "key": "extra", "title": "Услуги", "metric": "extra", "width": 110 },
    { "key": "discount", "title": "Скидки", "metric": "discount", "width": 110 },
    { "key": "total", "title": "Итого", "metric": "total", "width": 130 },
    { "key": "bookings", "title": "Броней", "metric": "bookings", "width": 80 }
  ],
  "sort": [{ "key": "group", "dir": "asc" }],
  "chart": { "type": "bar", "x": "group", "y": "total" },
  "totalsLabel": "Итого за период"
}
