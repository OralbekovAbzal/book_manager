{
  "name": "hotel-booking-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Roomline PMS — система бронирования (хост/клиент)",
  "author": "Roomline",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hotelbooking.desktop",
    "productName": "Roomline PMS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "lib/**",
      "preload.js",
      "settings-preload.js",
      "settings.html",
      "package.json"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "renderer"
      },
      {
        "from": "vcredist",
        "to": "app/node_modules/@embedded-postgres/windows-x64/native/bin",
        "filter": [
          "*.dll"
        ]
      },
      {
        "from": "db",
        "to": "db"
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!logs/**",
          "!backups/**",
          "!scripts/**",
          "!test/**",
          "!vitest.config.mjs",
          "!server.log",
          "!server.err"
        ]
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*",
          "!.bin/**",
          "!nodemon/**",
          "!vitest/**",
          "!@vitest/**",
          "!vite/**",
          "!rolldown/**",
          "!@rolldown/**",
          "!lightningcss/**",
          "!lightningcss-*/**",
          "!tinybench/**",
          "!.prisma/client/*.tmp*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.invalid/hotel-booking/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "include": "installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Roomline PMS"
    }
  }
}
