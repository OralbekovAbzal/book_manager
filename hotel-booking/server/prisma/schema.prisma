generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id         Int         @id @default(autoincrement())
  /// Коллация pg_c_utf8 задана миграцией 20260908140000 (поиск без учёта регистра
  /// по кириллице во встроенном Postgres); при смене типа колонки COLLATE указать
  /// в миграции явно.
  number     String      @unique
  categoryId Int
  category   Category    @relation(fields: [categoryId], references: [id])
  building   String
  floor      Int
  features   String[]
  capacity   String      @default("")
  isActive   Boolean     @default(true)
  bookings   Booking[]
  allotments Allotment[]
  createdAt  DateTime    @default(now())

  @@index([categoryId])
  @@index([building, floor])
  @@index([isActive, categoryId, building, floor])
}

model Category {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  color       String
  description String?
  rooms       Room[]
  rates       RatePrice[]
}

// ─── Справочники номерного фонда: корпуса, особенности, вместимости ──────────
//
// Раньше все три жили в localStorage клиента (`RoomFundConfig` в
// `client/src/store/useSettingsStore.ts`). На двух рабочих местах они молча
// разъезжались: администратор завёл «Корпус Б» на одном ноуте — на втором его
// нет, и номер показывается без корпуса. Тот же переезд, что уже сделан для
// меток броней (`BookingFlag`) и тарифов.
//
// ВАЖНО — СВЯЗЬ С `Room` НАМЕРЕННО НЕ ВНЕШНИЙ КЛЮЧ.
// `Room` этой правкой не меняется и хранит по-прежнему СТРОКИ:
//   `Room.building` — НАЗВАНИЕ корпуса        → сходится с `Building.name`
//   `Room.features` — массив НАЗВАНИЙ         → сходится с `RoomFeature.name`
//   `Room.capacity` — КОД вместимости         → сходится с `RoomCapacity.code`
// (обрати внимание на асимметрию: вместимость связана по коду, корпус и
// особенность — по названию. Так их писал клиент, и менять это здесь значило бы
// переписать данные всех номеров.)
//
// Почему без FK: переезд на внешние ключи — это миграция данных по всем номерам
// плюс правка сетки, фильтров и подбора номеров. Отдельная задача. Поступаем как
// с `BookingFlag`, где `Booking.flags` тоже остался `String[]`.
//
// ЧЕМ ЗА ЭТО ПЛАТИМ: переименование корпуса или особенности само по себе разъехало
// БЫ связь с номерами — они остались бы со старым названием и выпали из фильтра.
// Поэтому переименование правит не только справочник: `roomFundController`
// в ТОЙ ЖЕ транзакции переписывает и номера (`Room.building` — `updateMany`,
// `Room.features` — `array_replace`) и возвращает `renamedRooms`. Правя эти модели
// или заводя ещё один способ переименования, помни: справочник и `Room` обязаны
// меняться вместе, иначе номера потеряют корпус или особенность молча.
//
// Удаление: не физическое, а `isActive = false` («скрыть/показать» из NOTES).
// Особенность, которая стоит у живых номеров, удалять нельзя — её прячут.

/// Корпус отеля. `name` — ключ связи с `Room.building`, поэтому уникален.
/// `roomController` пишет `Room.building` в ВЕРХНЕМ регистре
/// (`building.trim().toUpperCase()`), поэтому и здесь имя приводится к верхнему
/// регистру: иначе фильтр «по корпусу» (точное сравнение строк) не найдёт номера.
model Building {
  id          Int      @id @default(autoincrement())
  /// Стабильный идентификатор. Связь с номерами идёт НЕ по нему, а по `name`;
  /// код нужен, чтобы переименование не ломало ссылки в настройках и импорте.
  code        String   @unique
  name        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

/// Особенность номера (балкон, кондиционер, тип кровати).
/// `name` — ключ связи с `Room.features[]`, поэтому уникален.
/// На него же ссылается эффект метки `requireFeature` (см. `BookingFlag.effects`).
model RoomFeature {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String   @unique
  /// Значок для сетки и фильтров. null — клиент подставит свой запасной.
  emoji     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// Тип вместимости номера («Двухместный» = 2 гостя).
/// Здесь ключ связи — `code`: именно код лежит в `Room.capacity`
/// ('single', 'double', …), поэтому переименование label безопасно —
/// в отличие от корпусов и особенностей.
model RoomCapacity {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  /// Сколько гостей помещается. 0 — значение неизвестно (код пришёл из данных,
  /// а его расшифровка осталась в localStorage машины, где его завели).
  value     Int      @default(0)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Метки броней + их эффекты для алгоритма. Источник истины (раньше — localStorage).
// `code` — стабильный идентификатор, который хранится в Booking.flags[].
// `effects` — JSON { bufferAfter, bufferBefore, pin }.
model BookingFlag {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  color     String?
  effects   Json?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Booking {
  id                 Int           @id @default(autoincrement())
  roomId             Int
  room               Room          @relation(fields: [roomId], references: [id])
  /// Коллация pg_c_utf8 задана миграцией 20260908140000 (поиск без учёта регистра
  /// по кириллице во встроенном Postgres); при смене типа колонки COLLATE указать
  /// в миграции явно.
  guestName          String
  guestPhone         String?
  /// ─── Документ гостя ────────────────────────────────────────────────────────
  /// Поля лежат ПРЯМО НА БРОНИ, отдельной сущности «Гость» намеренно нет.
  /// Сейчас гость — это и есть поля брони (`guestName`/`guestPhone`), а вкладка
  /// «Гости» собирается свёрткой броней по нормализованному телефону
  /// (`guestController.js`). Отдельная таблица означала бы миграцию всех живых
  /// броней, дедупликацию людей по неточным данным и переделку формы — на 1.0
  /// это не тянет. Плата за решение: у одной брони один комплект документов
  /// (документ второго проживающего записать некуда), а повторный гость приезжает
  /// «чистым» — поэтому есть подстановка из прошлого визита
  /// (`GET /api/guests/lookup?phone=…`), а не ручной перенос.
  ///
  /// Состав полей — не «что показалось нужным», а ровно то, что требует
  /// уведомление о прибытии иностранца (МВД/eQonaq) и статистика по гражданству
  /// (форма 2-туризм). Самих выгрузок в 1.0 НЕТ, но собирать данные надо уже
  /// сейчас: иначе к моменту, когда они понадобятся, отправлять будет нечего —
  /// историю задним числом не восстановишь.
  ///
  /// ВСЕ поля необязательные, и это не небрежность: бронь по телефону заводят за
  /// недели до приезда, документ появляется только на стойке при заселении.
  /// Обязательность здесь означала бы «нельзя забронировать без паспорта».
  ///
  /// Гражданство — свободный текст, как записано в документе. Справочник стран
  /// это отдельная работа, а неполный справочник хуже строки: гостя из страны,
  /// которой в списке нет, оформить будет нечем.
  guestCitizenship   String?
  /// 'passport' | 'id_card' | 'other'. У граждан РК документ при заселении —
  /// удостоверение личности, у иностранцев — паспорт; это разные номера.
  guestDocType       String?
  guestDocNumber     String?
  /// Срок действия и дата рождения — @db.Date: это календарные дни, а не моменты
  /// времени (в отличие от actualCheckInAt ниже), время в них смысла не несёт.
  guestDocExpiry     DateTime?     @db.Date
  guestBirthDate     DateTime?     @db.Date
  /// 'm' | 'f' — как в документе. Строка, а не enum: enum в Postgres расширяется
  /// миграцией, а это данные, а не структура.
  guestSex           String?
  checkIn            DateTime      @db.Date
  checkOut           DateTime      @db.Date
  status             BookingStatus @default(CONFIRMED)
  /// ФАКТИЧЕСКИЙ момент заезда/выезда (часы:минуты), а не плановая дата:
  /// checkIn/checkOut — это @db.Date без времени, они говорят «на какие сутки
  /// продан номер», и по ним считаются пересечения и деньги. Здесь же —
  /// когда статус реально проставили: заполняется автоматически кнопками
  /// «Заезд»/«Выезд», админ может поправить вручную (заехали ночью, выезд
  /// оформили задним числом). Nullable: у старых броней этого следа нет,
  /// и у брони, до которой гость не доехал, его не будет никогда.
  actualCheckInAt    DateTime?
  actualCheckOutAt   DateTime?
  source             String?
  notes              String?
  adultsWithMeals    Int           @default(0)
  childrenWithMeals  Int           @default(0)
  adultsNoMeals      Int           @default(0)
  childrenNoMeals    Int           @default(0)
  extraBedsWithMeals Int           @default(0)
  extraBedsNoMeals   Int           @default(0)
  disabledAdults     Int           @default(0)
  disabledChildren   Int           @default(0)
  discountPercent    Float         @default(0)
  prepaymentPercent  Float         @default(50)
  totalAmount        Float         @default(0)
  prepaidAmount      Float         @default(0)
  paidAmount         Float         @default(0)
  flags              String[]      @default([])
  partnerId          Int?
  partner            Partner?      @relation(fields: [partnerId], references: [id])
  /// Бронь продана ПОВЕРХ квоты партнёра — вопрос «номер выделен партнёру X,
  /// продать всё равно?» уже задан и подтверждён, повторно не спрашиваем.
  /// Без этого флага любая последующая правка (поправить телефон гостя) снова
  /// упиралась в 409 от проверки квоты — бронь становилась нередактируемой
  /// (аудит D3-003, D7-005). Квота теперь предупреждение, а не запрет.
  /// Флаг привязан к КОНКРЕТНОМУ размещению: при смене номера или дат сервер
  /// сбрасывает его и задаёт вопрос заново — подтверждали продажу одного номера,
  /// а не право игнорировать любые квоты.
  allotmentOverride  Boolean       @default(false)
  shiftId            Int?
  shift              Shift?        @relation(fields: [shiftId], references: [id])
  adminId            Int
  createdBy          Admin         @relation(fields: [adminId], references: [id])
  /// Начисления. totalAmount — кэш их суммы, источник истины здесь.
  charges            BookingCharge[]
  /// Питание и услуги ИМЕННО ЭТОЙ брони (кому и сколько). Из них генератор
  /// строит начисления — глобального флага includedByDefault для этого мало.
  services           BookingService[]
  /// Принятые деньги. paidAmount — кэш их суммы, источник истины здесь.
  payments           Payment[]
  /// ─── Счёт брони: цепочка после переезда ───────────────────────────────────
  /// Непусто = эта бронь ПРОДОЛЖЕНИЕ после переезда, а её деньги (строки
  /// начислений и платежи) лежат на голове цепочки — броне, на которую указывает
  /// ссылка. У продолжения totalAmount/prepaidAmount/paidAmount = 0 и своих
  /// BookingCharge/Payment нет.
  ///
  /// Почему так, а не «половина денег в каждой части»: переезд физически делит
  /// бронь на две записи (иначе не нарисовать два блока в шахматке и не проверить
  /// пересечения), но для гостя это ОДИН счёт. Прежняя дележка paidAmount
  /// пропорцией ночей оставляла платежи на первой части, не делила питание и
  /// скидку и без посуточных строк удваивала начисления (аудит D3-001/002, D7-013).
  /// Одна голова = стабильный id, к которому привязаны деньги, касса, печать
  /// и долги; сегменты дают только даты, номер и категорию для расчёта отрезков.
  ///
  /// onDelete: SetNull, а не Cascade: удаление головы не должно уносить
  /// продолжение вместе с прожитыми ночами — сирота лучше пропавшей брони.
  /// Голова всегда старше продолжения по id, поэтому восстановление копии и
  /// снимка в порядке id проставляет самоссылку без второго прохода.
  accountBookingId   Int?
  account            Booking?      @relation("BookingAccount", fields: [accountBookingId], references: [id], onDelete: SetNull)
  continuations      Booking[]     @relation("BookingAccount")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([roomId, checkIn, checkOut])
  @@index([checkIn, checkOut])
  @@index([checkIn, checkOut, status])
  @@index([adminId])
  @@index([status, checkIn])
  @@index([shiftId])
  @@index([partnerId])
  @@index([accountBookingId])
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Admin {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password      String
  name          String
  /// Роль по умолчанию — ADMIN: STAFF убрана решением 2026-09-08
  /// (`docs/decisions/interface.md`). Само значение STAFF из enum НЕ удаляем —
  /// смена enum в Postgres требует пересоздания типа ради данных, которых после
  /// миграции всё равно не останется. Создание STAFF запрещено на сервере,
  /// в интерфейсе роли нет.
  role          AdminRole @default(ADMIN)
  isActive      Boolean   @default(true)
  /// Версия сессии. JWT несёт её в claim `tv`; middleware/auth.js и handshake
  /// сокета сравнивают claim с этим полем, несовпадение — 401. Увеличивается
  /// при выходе и при смене/сбросе пароля: так «выйти на всех устройствах»
  /// стоит одно сравнение в уже существующем запросе, без таблицы отозванных
  /// токенов и без чистки по cron. Токены, выпущенные до появления поля,
  /// claim'а не имеют и читаются как версия 0 — обновление никого не разлогинит.
  tokenVersion  Int       @default(0)
  bookings      Booking[]
  shiftsCreated Shift[]   @relation("ShiftCreator")
  snapshots     Snapshot[]
  charges       BookingCharge[]
  payments      Payment[]          @relation("PaymentTaker")
  paymentsVoid  Payment[]          @relation("PaymentVoider")
  auditLogs     AuditLog[]
  reports       ReportDefinition[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Пользовательские отчёты: созданные в конструкторе, отредактированные копии
/// встроенных, импортированные из JSON. Встроенные отчёты лежат файлами в
/// `server/src/reports/definitions/` и в БД не дублируются.
/// `key` — строковый id из определения (он же в URL `/api/reports/:id`); уникален
/// и среди встроенных, за этим следит реестр. `definition` — само определение
/// (параметры, фильтры, колонки…), которое исполняет движок отчётов.
model ReportDefinition {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  title       String
  description String?
  definition  Json
  createdById Int?
  createdBy   Admin?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
}

/// Журнал действий: кто, когда и что изменил (брони, переход дня, оптимизатор,
/// пользователи, фонд, бэкапы). Пишется middleware/audit.js по успешным
/// POST/PUT/PATCH/DELETE. adminName дублируется, чтобы запись читалась и после
/// деактивации/удаления сотрудника (adminId тогда становится NULL).
model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName String
  /// Например 'POST /bookings', 'PATCH /bookings/12/checkin'
  action    String
  /// Первый сегмент пути: 'bookings', 'users', 'system'…
  entity    String
  entityId  Int?
  /// Тело запроса без паролей, не длиннее 2 КБ
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

model License {
  id         Int      @id @default(1)
  key        String
  hardwareId String
  expiresAt  DateTime
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model Shift {
  id          Int       @id @default(autoincrement())
  date        DateTime  @db.Date
  createdById Int
  createdBy   Admin     @relation("ShiftCreator", fields: [createdById], references: [id])
  bookings    Booking[]
  /// Касса смены: всё, что принято и возвращено за этот рабочий день.
  payments    Payment[]
  createdAt   DateTime  @default(now())

  @@unique([date])
  @@index([date])
}

model BackupLog {
  id        Int      @id @default(autoincrement())
  path      String
  size      Int
  success   Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Лёгкие снимки состояния броней для быстрого отката.
// kind: 'auto' (после манипуляции), 'shift' (старт смены), 'manual' (вручную), 'safety' (перед откатом)
model Snapshot {
  id           Int      @id @default(autoincrement())
  kind         String
  label        String
  bookingCount Int      @default(0)
  data         Json
  createdById  Int?
  createdBy    Admin?   @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

/// Партнёр / Бюро путешествий
model Partner {
  id                Int         @id @default(autoincrement())
  name              String      @unique
  color             String      @default("#6366f1")
  defaultCheckInDay Int?        // 0=вс, 1=пн ... 6=сб (null = любой)
  defaultNights     Int         @default(7)
  commissionPercent Float?      // опционально
  contactPerson     String?
  contactPhone      String?
  notes             String?
  isActive          Boolean     @default(true)
  allotments        Allotment[]
  bookings          Booking[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

/// Квота: партнёру выделен номер на конкретный период
model Allotment {
  id        Int       @id @default(autoincrement())
  partnerId Int
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  roomId    Int
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dateFrom  DateTime  @db.Date
  dateTo    DateTime  @db.Date
  notes     String?
  releases  Release[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([roomId, dateFrom, dateTo])
  @@index([partnerId])
}

/// Релиз: временное освобождение части аллокированного периода для прямой продажи
model Release {
  id          Int       @id @default(autoincrement())
  allotmentId Int
  allotment   Allotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)
  dateFrom    DateTime  @db.Date
  dateTo      DateTime  @db.Date
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([allotmentId, dateFrom, dateTo])
}

/// Справочник контактов отеля: сотрудники, службы, подрядчики, экстренные номера.
/// `group` — строка из фиксированного пресета (см. CONTACT_GROUPS на клиенте):
/// клиент не настраивает группы, он только заполняет записи.
model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?
  group     String   @default("Службы отеля")
  phones    String[] @default([])
  email     String?
  notes     String?
  isPinned  Boolean  @default(false)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, order])
  @@index([isPinned])
}

/// Настройки объекта. Одна строка (id = 1).
/// Заодно убирает хардкод названия отеля из App.tsx.
model HotelSettings {
  id          Int      @id @default(1)
  name        String   @default("Отель")
  city        String?
  currency    String   @default("KZT")
  /// 'room' — цена за номер целиком, 'person' — за место.
  /// Настройка на весь объект: меняется генератор начислений, вид строк одинаков.
  pricingBase String   @default("person")
  /// Час, до которого заезд считается «поздним» (для правила половины суток).
  /// null — правило выключено.
  lateArrivalHour Int?
  /// Когда завершён мастер первичной настройки (создан главный администратор).
  /// null — или строки id=1 нет вообще — значит мастер не пройден и
  /// POST /api/setup/complete ещё открыт. После завершения он отвечает 403.
  setupCompletedAt DateTime?
  /// Начало пробного периода: 14 дней работы без лицензионного ключа
  /// (срок и правило — в `utils/license.js`). Проставляет сервер при первом
  /// старте, если пусто.
  ///
  /// ПОЧЕМУ В БАЗЕ, А НЕ В `config.json` ELECTRON: при переезде на новый ноутбук
  /// едет резервная копия базы, а не конфиг (см. волну 6a). Держи мы дату в
  /// конфиге — переустановка программы или новый ноутбук обнуляли бы пробный
  /// период, то есть «бесплатно навсегда» в одну переустановку.
  ///
  /// null — сервер ещё не проставил (строки id=1 не было): гейт при null не
  /// закрывает, иначе свежая установка упиралась бы в замок до первого старта.
  trialStartedAt DateTime?

  // ─── Реквизиты для печатных документов ─────────────────────────────────────
  // Счёт на оплату турфирме и подтверждение брони гостю печатаются с шапкой:
  // кто выставляет, по каким реквизитам платить, кто подписал. Без этого блока
  // печать выдаёт бумажку, а не документ, с которым турфирма пойдёт в банк.
  //
  // ВСЕ поля необязательные и печать ими НЕ блокируется: выводится то, что
  // заполнено, отсутствующие строки шапки просто не печатаются. Обратное
  // (требовать полный комплект) означало бы, что новая установка не может
  // напечатать подтверждение брони, пока владелец не найдёт свой IBAN.
  //
  // Формат не проверяется базой — только роутом (`routes/hotel.js`): в схеме
  // не выразить «12 цифр» без CHECK-констрейнта, а жёсткий констрейнт на живых
  // данных ломает сохранение настроек из-за опечатки в чужом поле.

  /// Юридическое имя как в договоре: «ИП Оралбеков А.», «ТОО "Туран"».
  /// Отдельно от `name`, потому что в шапке документа нужно юрлицо,
  /// а в интерфейсе — коммерческое название базы.
  legalName   String?
  /// БИН (юрлицо) или ИИН (ИП) — 12 цифр. Строка, а не число: ведущий ноль
  /// значащий, и арифметики с ним не бывает.
  bin         String?
  /// Юридический адрес одной строкой — так он и печатается в шапке.
  address     String?
  phone       String?
  email       String?
  /// Банк получателя и счёт: по ним турфирма платит по счёту.
  bankName    String?
  /// IBAN. У Казахстана это «KZ» + 18 знаков, но проверяем мягко (длина и
  /// префикс страны), иначе счёт в иностранном банке не сохранить.
  iban        String?
  /// Кто подписывает счёт и должность в подписи: «Оралбеков А.» / «Директор».
  /// Хранится в настройках, а не берётся из учётки: счёт подписывает
  /// руководитель, а печатает его администратор стойки.
  signerName  String?
  signerTitle String?

  // ─── Личность установки (по ней рабочие места находят свой хост) ───────────

  /// Личность установки: по ней рабочее место узнаёт «свой» хост в локальной
  /// сети среди чужих. Искать по адресу нельзя — адрес хоста меняется от раздачи
  /// DHCP, а в одной сети может стоять вторая установка (у владельца две базы
  /// отдыха), и клиент подключится не к той базе.
  ///
  /// ПОЧЕМУ В БАЗЕ, А НЕ В `config.json` ELECTRON. `config.json` лежит в
  /// `%APPDATA%` хоста и при переезде на новый ноутбук не едет — едет резервная
  /// копия базы (перенос устроен именно так, см. волну 6a). Личность внутри базы
  /// переезжает вместе с бронями: хост поднимается на новом ноутбуке с той же
  /// личностью, и рабочие места находят его сами. Держи мы её в конфиге — после
  /// переноса у хоста была бы новая личность, и каждое рабочее место пришлось бы
  /// обходить руками и перепривязывать, причём в тот самый день, когда старый
  /// ноутбук уже умер.
  ///
  /// Значения проставляет сервер при первом старте, если пусто. Отсюда nullable
  /// и отсутствие дефолтов: пару ключей в SQL-дефолте не сгенерировать, а NOT NULL
  /// потребовал бы задним числом заполнить строку на живой базе. Уникальный индекс
  /// не нужен — строка ровно одна (id = 1).
  instanceId         String?
  /// Публичная половина пары: её хост объявляет в сети, по ней рабочее место
  /// убеждается, что отвечает именно тот хост, к которому оно привязано.
  instancePublicKey  String?
  /// Приватная половина. НИКОГДА не отдаётся наружу: ни в ответе API, ни в
  /// объявлении по сети, ни в логах. Поэтому `GET /api/hotel` отдаёт настройки
  /// по белому списку `select` (его ведёт серверная часть), а не модель целиком:
  /// при выдаче объекта целиком добавление поля в схему начало бы публиковать
  /// его молча, и никто бы этого не заметил. Утечка ключа = любой ноутбук в сети
  /// может выдать себя за хост, и рабочие места понесут ему данные.
  instancePrivateKey String?

  updatedAt   DateTime @updatedAt
}

/// Календарь цен: одна строка на (категория, дата).
/// Храним по дням, а заполняем диапазонами — иначе год = 365 правок.
/// Какие поля используются, зависит от HotelSettings.pricingBase.
model RatePrice {
  id            Int      @id @default(autoincrement())
  categoryId    Int
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  /// pricingBase = 'room'
  roomPrice     Float?
  /// pricingBase = 'person'
  adultPrice    Float?
  childPrice    Float?
  extraBedPrice Float?
  updatedAt     DateTime @updatedAt

  @@unique([categoryId, date])
  @@index([date])
}

/// Питание и дополнительные услуги. Питание — это НЕ флаг у брони,
/// а обычные услуги: завтрак, обед, ужин по отдельности. Тогда «только завтрак»
/// или «завтрак + ужин» выражаются без единой правки кода.
model Service {
  id         Int     @id @default(autoincrement())
  code       String  @unique
  name       String
  price      Float   @default(0)
  /// Цена для детей. null — считать как взрослую.
  /// Отдельное поле, потому что детский обед дешевле почти везде.
  childPrice Float?
  /// Как начисляется:
  /// 'per_person_night' — за человека за ночь (питание)
  /// 'per_night'        — за ночь, независимо от числа гостей (парковка)
  /// 'per_person'       — за человека однократно (трансфер)
  /// 'per_booking'      — однократно за бронь (поздний выезд)
  unit       String  @default("per_person_night")
  /// 'meal' — питание (участвует в пресетах пансиона), 'extra' — прочее
  kind       String  @default("extra")
  /// Что подставляется в НОВУЮ бронь по умолчанию (завтрак «включён в тариф»).
  /// Именно подставляется в форму — на уже сохранённую бронь этот флаг не влияет:
  /// что ей начислять, решают строки BookingService.
  includedByDefault Boolean @default(false)
  isActive   Boolean @default(true)
  order      Int     @default(0)
  bookings   BookingService[]

  @@index([kind, order])
}

/// Услуга, подключённая к КОНКРЕТНОЙ брони: что, скольким и сколько раз.
///
/// До этой таблицы питание цеплялось глобальным флагом `Service.includedByDefault`,
/// а «кому начислять» выражалось счётчиками гостей «с питанием» / «без питания».
/// Из-за этого «завтрак на двоих из троих» описать было нечем: либо всем, либо никому,
/// а разбиение гостей на две колонки заодно делало форму нечитаемой (шесть счётчиков).
/// Теперь гости считаются один раз (взрослые / дети / доп. места), а число едоков
/// живёт здесь — у самой услуги.
///
/// Как читается по единицам начисления (`Service.unit`):
/// - `per_person_night` — (adults + children) × ночи   → «завтрак на 2 из 3 гостей»
/// - `per_person`       — (adults + children)          → «трансфер на двоих»
/// - `per_night`        — quantity × ночи              → «парковка на все ночи»
/// - `per_booking`      — quantity                     → «поздний выезд, один раз»
/// `adults` и `children` раздельно, потому что у услуги может быть детская цена
/// (`Service.childPrice`), и «двое взрослых + ребёнок» стоит не столько же, сколько трое взрослых.
model BookingService {
  id        Int      @id @default(autoincrement())
  bookingId Int
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId Int
  /// Cascade, а не Restrict: удаление услуги из справочника не должно упираться
  /// в старые брони. Деньги от этого не теряются — они уже записаны строками
  /// BookingCharge, а те живут отдельно от справочника.
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  adults    Int      @default(0)
  children  Int      @default(0)
  /// Для услуг, не зависящих от числа людей (per_night, per_booking): сколько раз.
  quantity  Float    @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Одна услуга подключается к брони один раз — «завтрак» и «ещё завтрак» это
  /// не два ряда, а одно число едоков.
  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@index([serviceId])
}

/// Пресет питания: «Полный пансион», «Полупансион», «Только завтрак».
/// Кнопка, которая включает набор услуг — не отдельная сущность в брони.
model MealPlan {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  serviceCodes String[] @default([])
  order        Int      @default(0)
}

/// Начисление по брони. КЛЮЧЕВАЯ идея ценообразования:
/// итог брони — это СУММА СТРОК, а не результат формулы.
///
/// Тариф лишь порождает строки (source='auto'); администратор может строку
/// поправить, удалить или добавить свою (source='manual' + обязательная reason).
/// Поэтому уступка «заехали в час ночи, беру полсуток» остаётся ВНУТРИ системы,
/// а не в голове администратора — и деньги в системе сходятся с деньгами на руках.
model BookingCharge {
  id          Int       @id @default(autoincrement())
  bookingId   Int
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// 'stay' — проживание, 'meal' — питание, 'extra' — услуга, 'discount' — скидка (amount < 0)
  kind        String
  label       String
  quantity    Float     @default(1)
  unitPrice   Float     @default(0)
  /// quantity * unitPrice, храним посчитанным — итог не должен зависеть от версии кода
  amount      Float     @default(0)
  /// Для посуточных строк — за какую дату начислено (нужно для отчётов по дням)
  date        DateTime? @db.Date
  /// 'auto' — сгенерировано тарифом, 'manual' — правка администратора
  source      String    @default("auto")
  reason      String?
  createdById Int?
  createdBy   Admin?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([bookingId])
  @@index([date])
}

/// Платёж по брони — журнал ПРИНЯТЫХ денег.
///
/// Вторая половина задачи «суммы в программе сходятся с деньгами на руках»:
/// начисления (BookingCharge) отвечают на вопрос «сколько гость должен»,
/// платежи — «сколько с него принято». Долг = сумма начислений − сумма платежей.
///
/// До этой модели у брони были три числа (totalAmount / prepaidAmount / paidAmount)
/// без истории: по ним нельзя закрыть смену и нельзя сказать, кто принял деньги.
/// Теперь `Booking.paidAmount` — КЭШ суммы платежей, а не самостоятельное число.
model Payment {
  id           Int       @id @default(autoincrement())
  bookingId    Int
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// 'payment' — приём денег, 'refund' — возврат гостю.
  /// `amount` ВСЕГДА положительная, знак задаёт kind: в отчёте по кассе нужно
  /// видеть оборот и возвраты по отдельности, а не одну нетто-цифру.
  kind         String    @default("payment")
  amount       Float

  /// Способ: 'cash' | 'card' | 'transfer'. По нему сводится касса в конце смены:
  /// наличные пересчитывают в ящике, карта и перевод сверяются с выпиской.
  method       String    @default("cash")

  /// Кто принял. adminName продублирован строкой, чтобы запись читалась и после
  /// деактивации сотрудника (adminId тогда становится NULL) — как в AuditLog.
  adminId      Int?
  admin        Admin?    @relation("PaymentTaker", fields: [adminId], references: [id], onDelete: SetNull)
  adminName    String

  /// Смена, в которую попал платёж. Касса закрывается по СМЕНЕ, а не по
  /// календарным суткам: сутки в отеле не равны календарным (см. businessDate.js).
  shiftId      Int?
  shift        Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  /// Копия shift.date на момент приёма: отчёт за период не требует join
  /// и переживает удаление смены.
  businessDate DateTime? @db.Date

  /// Фактический момент приёма денег (реальные часы, не рабочая дата).
  paidAt       DateTime  @default(now())
  comment      String?

  /// Возврат ссылается на исходный платёж — видно, по какой оплате вернули.
  refundOfId   Int?
  refundOf     Payment?  @relation("PaymentRefund", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds      Payment[] @relation("PaymentRefund")

  /// Отмена ОШИБОЧНОЙ записи (не тот номер, не та сумма). Платёж не удаляется
  /// никогда: дыра в нумерации кассы хуже лишней строки. Отменённый в суммы
  /// не входит, но остаётся виден вместе с причиной и автором отмены.
  voidedAt     DateTime?
  voidedById   Int?
  voidedBy     Admin?    @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason   String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([bookingId])
  @@index([shiftId])
  @@index([businessDate])
  @@index([paidAt])
  @@index([refundOfId])
}
