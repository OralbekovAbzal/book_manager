# ============================
# База данных
# ============================
DATABASE_URL="postgresql://postgres:password@localhost:5432/hotel_booking"

# ============================
# Сервер
# ============================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# URL клиента (для CORS)
CLIENT_ORIGIN=http://localhost:5173

# ============================
# JWT
# ============================
JWT_SECRET=замените-на-длинную-случайную-строку-минимум-32-символа
JWT_EXPIRES_IN=8h

# ============================
# Лицензии
# ============================
# Онлайн-проверки нет: ключ проверяется офлайн подписью Ed25519 (utils/license.js),
# программа работает в отеле без интернета. LICENSE_SERVER_URL убран 06.09.2026
# вместе с сервером лицензий — если он встретился в вашем .env, это старая строка.
#
# ROOMLINE_BUILD_DATE — ручной обход даты выпуска сборки (ГГГГ-ММ-ДД). В норме дата
# штампуется в server/package.json при упаковке (scripts/stamp-build-date.js),
# и трогать её не нужно. Прежнее имя QONAQ_BUILD_DATE читается как запасное
# (продукт переименован Qonaq → Roomline PMS 09.09.2026).
# ROOMLINE_BUILD_DATE=2026-09-06

# ============================
# Бэкапы (JSON-дамп всех таблиц средствами приложения, pg_dump не нужен)
# ============================
BACKUP_PATH=C:\HotelBooking\backups
# Сколько последних файлов копий хранить (старые удаляются автоматически)
BACKUP_KEEP=14
# Часовой пояс для ночной копии (03:00) и метки времени в имени файла.
# Сервер работает в TZ=UTC, поэтому без этой настройки «03:00» наступало бы в 08:00 по Алматы.
BACKUP_TZ=Asia/Almaty

# ============================
# Снапшоты (server/src/utils/snapshot.js)
# ============================
# Сколько снимков каждого вида хранить и пауза перед авто-снимком (мс).
# Значения ниже — те же, что зашиты в коде по умолчанию; менять не обязательно.
# SNAPSHOT_KEEP_AUTO=15
# SNAPSHOT_KEEP_SHIFT=15
# SNAPSHOT_KEEP_MANUAL=20
# SNAPSHOT_KEEP_SAFETY=10
# SNAPSHOT_DEBOUNCE_MS=1200

# ============================
# Место на диске
# ============================
# Порог предупреждения «мало места» в мегабайтах: ниже него GET /api/system/status
# отдаёт disk.warning = true. По умолчанию 1024 (1 ГБ).
# DISK_WARN_MB=1024
# Папка данных встроенного Postgres — её выставляет Electron при запуске сервера
# (в dev база своя, и переменная не нужна). Нужна только для замера свободного
# места: без неё том с базой в статусе не проверяется.
# PG_DATA_DIR=C:\Users\<имя>\AppData\Roaming\hotel-booking-desktop\pgdata

# ============================
# Журнал действий (таблица AuditLog)
# ============================
# Сколько дней хранить записи журнала «кто что менял». Раз в сутки в 03:30
# (по BACKUP_TZ, сразу после ночной копии) более старые удаляются; первый прогон —
# через 2 минуты после запуска сервера.
# 0 — не чистить никогда (журнал растёт бесконечно вместе с резервными копиями).
# Номера документов, даты рождения и пол в журнал не пишутся вовсе — вырезаются
# при записи (server/src/middleware/audit.js). Имя и телефон гостя остаются:
# без них журнал не отвечает на вопрос «кто менял чью бронь».
AUDIT_RETENTION_DAYS=365

# ============================
# Логи
# ============================
LOG_PATH=logs

# Ротация логов настройкой не управляется: error.log и combined.log режутся по
# 5 МБ и хранятся по 5 файлов (server/src/utils/logger.js), host-debug.log в
# Electron переименовывается в .1 при старте, если перевалил за 5 МБ.
# В строку запроса пишутся только ИМЕНА query-параметров, без значений
# (`?keys=dateFrom,guestSearch`): в значениях ФИО и телефоны гостей, а логи
# пересылают в поддержку целиком.

# Примечание: TZ в .env бессмысленна — server.js выставляет process.env.TZ='UTC'
# до загрузки dotenv (иначе даты @db.Date уезжают на сутки).
