# Dependencies
node_modules/

# Builds
dist/
build/
.vite/

# Secrets / env
# Приватный ключ выпуска лицензий живёт вне репозитория (OneDrive), но страхуемся:
# случайно положенный сюда .pem обесценил бы все выпущенные ключи разом.
*.pem
*.key
.env
.env.*
!.env.example

# Logs
logs/
*.log
*.err

# Database dumps & backups
# NB: общий `*.sql` здесь стоял раньше и молча выкидывал из репозитория СХЕМУ —
# electron/db/init.sql (то, из чего разворачивается свежая установка) и SQL-констрейнты.
# Схема — это код, она нужна в истории. Не нужны только дампы данных.
backup_*.sql
*.dump
backups/
hotel-booking/.logs/

# Design handoff artefacts (распакованные zip'ы и сами архивы — не часть приложения)
_design_code/
_design_import/
*.zip

# ВНИМАНИЕ: миграции Prisma намеренно НЕ игнорируются.
# Они и есть способ обновлять базу у клиента, у которого уже есть данные.
# Пока проект на `db push`, миграций нет — но как только появятся, они должны
# лежать в репозитории, иначе обновление установленной программы невозможно.

# Claude Code local settings (machine-specific)
.claude/settings.local.json
# Пароль dev-базы и абсолютные пути машины — в git не место, образцы рядом:
# .mcp.json.example и .claude/launch.example.json
.mcp.json
.claude/launch.json

